{
  "name": "@spacatty/switchyard",
  "version": "0.2.0",
  "description": "One provider list for your coding agents: a local web UI that shares custom OpenAI-compatible providers between OpenCode, Z-Code and Pi, with automatic model discovery.",
  "keywords": [
    "opencode",
    "zcode",
    "pi",
    "coding-agent",
    "llm",
    "openai-compatible",
    "providers",
    "models",
    "config",
    "cli"
  ],
  "homepage": "https://github.com/spacatty/switchyard#readme",
  "bugs": {
    "url": "https://github.com/spacatty/switchyard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spacatty/switchyard.git"
  },
  "license": "MIT",
  "author": "spacatty",
  "bin": {
    "switchyard": "bin/cli.js",
    "occ-manager": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "check-schema": "node scripts/check-schema.js",
    "update-schema": "node scripts/check-schema.js --update",
    "test": "node scripts/smoke-test.js",
    "prepublishOnly": "npm run check-schema"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
